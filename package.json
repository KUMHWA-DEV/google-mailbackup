{
  "name": "google-mailbackup",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly Gmail -> Google Drive backup (Apps Script) with category-preserving index and search UI",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node dev/server.js",
    "login": "clasp login",
    "push": "clasp push -f",
    "open": "clasp open-script",
    "deploy": "bash dev/deploy.sh",
    "release": "npm test && npm run push && git push origin main",
    "mcp": "node mcp/server.js",
    "mcp:demo": "MAIL_BACKUP_FIXTURE=dev/fixtures/index.json node mcp/server.js"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "googleapis": "^180.0.0",
    "zod": "^4.6.5"
  }
}
